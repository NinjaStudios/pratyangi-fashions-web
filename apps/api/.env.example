# Copy to .env and fill in. Never commit .env. See apps/api/README.md.
NODE_ENV=development
PORT=4000

# MySQL 8. Tables are all named shop_*, so this can be the same database as the ERP or a separate one.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pratyangi
DB_PASSWORD=change-me
DB_NAME=pratyangi_shop

# The website address (comma separate several). Only these may call the API with cookies.
WEB_ORIGIN=http://localhost:3000

# Days a sign-in lasts.
SESSION_DAYS=30

# Number of reverse proxies in front of the API (1 behind nginx or most hosts), so rate limits see the real visitor IP. 0 = none.
# TRUST_PROXY=1

# "Continue with Google": the OAuth client ID (public, ends in .apps.googleusercontent.com). No client secret is needed.
GOOGLE_CLIENT_ID=

# Password-reset email, e.g. smtps://user:password@smtp.example.com:465. Empty in development prints codes to this console.
SMTP_URL=
MAIL_FROM=Pratyangi Fashions <no-reply@pratyangifashions.com>
