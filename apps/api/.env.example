# Copy to .env and fill in. Never commit .env. See apps/api/README.md.
NODE_ENV=development
PORT=4000

# MySQL 8 connection. Tables are all named shop_*, so this can be the same database as the ERP or a separate one.
# URL-encode special characters in the password (for example @ becomes %40).
DATABASE_URL=mysql://pratyangi:change-me@127.0.0.1:3306/pratyangi_shop

# The website address (comma separate several). Only these may call the API with cookies. The first one is used in emailed links.
WEB_ORIGIN=http://localhost:3000

# Days a sign-in lasts.
SESSION_DAYS=30

# Number of reverse proxies in front of the API (1 behind nginx or most hosts), so rate limits see the real visitor IP. 0 = none.
TRUST_PROXY=0

# Log level: fatal, error, warn, info, debug, trace or silent. Logs never contain cookies, passwords, codes or request bodies.
LOG_LEVEL=info

# "Continue with Google": the OAuth client ID (public, ends in .apps.googleusercontent.com). No client secret is needed.
GOOGLE_CLIENT_ID=

# Emails (verification links, password reset), e.g. smtps://user:password@smtp.example.com:465.
# Empty in development prints each email to this console; empty in production turns the emails off.
SMTP_URL=
MAIL_FROM=Pratyangi Fashions <no-reply@pratyangifashions.com>
