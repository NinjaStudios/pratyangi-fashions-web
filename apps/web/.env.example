# Copy this file to .env.local and fill in the values you have. Everything here is optional: the site runs without any of it.

# Address of the store API (apps/api, planned). Leave empty to use the in-browser demo accounts.
# Example: https://api.pratyangifashions.com
NEXT_PUBLIC_API_URL=

# Google "Sign in with Google" client ID (looks like 1234567890-abc123.apps.googleusercontent.com).
# Leave empty and the Google button explains it is not switched on yet. How to get one: docs/BACKEND_PLAN.md, "Sign in with Google".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
