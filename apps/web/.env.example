# Copy this file to .env.local and fill in the values you have. The site builds and runs without any of it.

# Address of the store API (apps/api). With this set, sign-in, sessions and saved addresses are real and live on the server.
# Local: http://localhost:4000      Live: https://api.pratyangifashions.com
# Use a sub-domain of the website's own domain on the live site: the sign-in cookie then counts as "same site".
NEXT_PUBLIC_API_URL=

# "Continue with Google": the OAuth client ID (public, ends in .apps.googleusercontent.com). There is no secret on the website.
# The SAME client ID must be set as GOOGLE_CLIENT_ID in apps/api/.env, which is where the token is checked.
# Leave empty and the Google button says it is not switched on yet. Steps: docs/BACKEND_PLAN.md, "Sign in with Google".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Review-only stand-in for the server: true keeps "accounts" in this browser's storage so every screen can be clicked through.
# It is NOT real authentication. Never set it on the live site. With neither this nor NEXT_PUBLIC_API_URL set, the sign-in forms
# say that accounts are not connected yet, instead of pretending. (The automated tests turn it on for their own build.)
NEXT_PUBLIC_AUTH_DEMO=
