{
  "name": "pratyangi-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "preview": "serve out --listen 3000 --no-clipboard",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "next build && playwright test",
    "test:e2e:ui": "next build && playwright test --ui",
    "test:e2e:headed": "next build && playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.545.0",
    "next": "^16.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "serve": "^14.2.6",
    "typescript": "~5.9.3"
  }
}
