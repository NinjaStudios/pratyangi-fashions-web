{
  "name": "pratyangi-fashions",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "pnpm --filter pratyangi-web run dev",
    "build": "pnpm --filter pratyangi-web run build",
    "preview": "pnpm --filter pratyangi-web run preview",
    "typecheck": "pnpm --filter pratyangi-web run typecheck",
    "test": "pnpm --filter pratyangi-web run test:e2e",
    "test:ui": "pnpm --filter pratyangi-web run test:e2e:ui",
    "test:headed": "pnpm --filter pratyangi-web run test:e2e:headed"
  }
}
